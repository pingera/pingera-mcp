# Pingera MCP Server - Docker Environment Configuration
# This file is specifically configured for Docker deployment (SSE mode)

# ============================================
# Authentication
# ============================================
# In SSE mode, clients provide credentials via Authorization headers.
# Server-side credentials are OPTIONAL and only used as fallback when:
# - REQUIRE_AUTH_HEADER=false (not recommended for production)
# - You want server to have a default credential for testing

# Uncomment if you need fallback credentials:
# PINGERA_API_KEY=your_api_key_here
# PINGERA_JWT_TOKEN=your_jwt_token_here

# Require clients to provide Authorization headers (recommended for production)
REQUIRE_AUTH_HEADER=true

# ============================================
# Transport Configuration (Pre-configured for Docker)
# ============================================
TRANSPORT_MODE=sse
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# ============================================
# Operation Mode
# ============================================
MCP_MODE=read-write

# ============================================
# Production Server Configuration
# ============================================
UVICORN_WORKERS=4
LOG_LEVEL=info

# ============================================
# API Configuration (Optional)
# ============================================
PINGERA_BASE_URL=https://api.pingera.ru/v1
PINGERA_TIMEOUT=30
PINGERA_MAX_RETRIES=3
