# Pingera API Configuration
# Use either API Key OR JWT Token (JWT Token takes precedence if both are set)
PINGERA_API_KEY=your_api_key_here
# PINGERA_JWT_TOKEN=your_jwt_token_here
PINGERA_BASE_URL=https://api.pingera.ru/v1

# Server Configuration
PINGERA_MODE=read_only
# Options: read_only, read_write

# Request Configuration
PINGERA_TIMEOUT=30
PINGERA_MAX_RETRIES=3

# Transport Configuration (for dual-mode support)
# Transport mode: stdio (default, for Claude Desktop) or sse (for HTTP clients)
TRANSPORT_MODE=stdio
# HTTP server configuration (only used when TRANSPORT_MODE=sse)
HTTP_HOST=0.0.0.0
HTTP_PORT=5000
REQUIRE_AUTH_HEADER=false

# Logging Configuration
PINGERA_DEBUG=false

# Server Name
PINGERA_SERVER_NAME=Pingera MCP Server