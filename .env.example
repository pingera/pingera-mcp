# --- Pingera API ---
# Credentials are required for the stdio transport and for HTTP with MCP_HTTP_AUTH=env.
# Use an API key (Settings -> API tokens) or a JWT access token; the JWT wins if both are set.
PINGERA_API_KEY=your_api_key_here
# PINGERA_JWT_TOKEN=
# PINGERA_BASE_URL=https://api.pingera.ru
# PINGERA_TIMEOUT=30
# PINGERA_MAX_RETRIES=3

# --- What the server exposes ---
# read_only (default) or read_write. read_only hides every tool that changes data.
# PINGERA_MODE=read_only
# Comma-separated toolsets: default, all, or names such as checks,results,alerts,heartbeats.
# PINGERA_TOOLSETS=default
# Or exact tool names (overrides PINGERA_TOOLSETS):
# PINGERA_TOOLS=list_checks,get_check,list_check_results

# --- Transport ---
# stdio (default, for desktop clients) or http (streamable HTTP).
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_PATH=/mcp
# HTTP credentials: request (default, multi-tenant: each request sends its own) or env (use the key above).
# MCP_HTTP_AUTH=request
# Optional DNS rebinding protection: only accept these Host / Origin values (comma-separated, host:* for any port).
# Without them only a loopback server with MCP_HTTP_AUTH=env restricts them (to localhost).
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=

# LOG_LEVEL=INFO
