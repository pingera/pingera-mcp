modules = ["nodejs-20", "python-3.11"]

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["libxcrypt"]

[workflows]
runButton = "MCP Server (STDIO)"

[[workflows.workflow]]
name = "MCP Server (STDIO)"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pingera_mcp"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "MCP Server (HTTP)"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "MCP_MODE=http python -m pingera_mcp"

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 8000
externalPort = 8000
exposeLocalhost = true
